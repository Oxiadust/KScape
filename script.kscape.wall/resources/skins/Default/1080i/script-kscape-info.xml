<?xml version="1.0" encoding="UTF-8"?>
<!-- Movie info screen (resources/lib/details.py). Hand-written. The right-hand column has three
     pages, chosen by Window.Property(page): the movie's facts (group 200, empty), Explore (300),
     Play Scenes (400), Cast &amp; Crew (500) and Details (600). Controls Python positions or shows (100, 150-154, 220-290) carry no
     <visible> tags of their own; the badge and rating images inside grouplists 270 and 285 are
     shown by window properties and sized by Python (resources/lib/badges.py). -->
