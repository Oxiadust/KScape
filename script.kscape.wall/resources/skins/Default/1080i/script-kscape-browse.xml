<?xml version="1.0" encoding="UTF-8"?>
<!-- Album and TV show screens (resources/lib/browse.py): the movie info screen's panel, with the
     album's tracks or the show's seasons / episodes in list 300 on the right. Hand-written; the
     menu (100) and the right-hand column (210-300) are positioned by Python, so those controls
     carry no <visible> tags. Window properties: title, art, shape (square | poster), favourite. -->
<window>
	<defaultcontrol always="true">100</defaultcontrol>
	<controls>
		<control type="group">
			<description>Display &amp; aspect ratio root (Includes_Display.xml)</description>
			<include>KScapeDisplay</include>
			<control type="group">
				<description>Panel: slides up from the bottom edge, like the movie info screen</description>
				<left>96</left>
				<top>48</top>
				<animation effect="slide" start="0,1032" end="0,0" time="420" tween="cubic" easing="out" condition="!String.IsEqual(Window(Home).Property(kscape.reduced),1)">WindowOpen</animation>
				<animation effect="fade" start="0" end="100" time="160" condition="!String.IsEqual(Window(Home).Property(kscape.reduced),1)">WindowOpen</animation>
				<animation effect="slide" start="0,0" end="0,1032" time="300" tween="cubic" easing="in" condition="!String.IsEqual(Window(Home).Property(kscape.reduced),1)">WindowClose</animation>
				<control type="image">
					<description>Shadow on the wall</description>
					<left>-24</left>
					<top>-24</top>
					<width>1776</width>
					<height>1032</height>
					<texture colordiffuse="90000000">kscape-white.png</texture>
				</control>
				<control type="image">
					<width>1728</width>
					<height>984</height>
					<texture colordiffuse="kscape_blue">kscape-white.png</texture>
				</control>
				<control type="image">
					<description>Left column</description>
					<top>64</top>
					<width>480</width>
					<height>920</height>
					<texture colordiffuse="kscape_blue_dark">kscape-white.png</texture>
				</control>
				<control type="image">
					<description>Header strip</description>
					<width>1728</width>
					<height>64</height>
					<texture colordiffuse="kscape_blue_head">kscape-white.png</texture>
				</control>
				<control type="label">
					<left>30</left>
					<width>1600</width>
					<height>64</height>
					<aligny>center</aligny>
					<font>kscape_info_head</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[Window.Property(title)]</label>
				</control>
				<control type="image">
					<description>In Kodi's favourites</description>
					<left>1666</left>
					<top>17</top>
					<width>32</width>
					<height>32</height>
					<texture colordiffuse="kscape_amber">kscape-heart.png</texture>
					<visible>String.IsEqual(Window.Property(favourite),1)</visible>
					<animation effect="zoom" start="60" end="100" center="auto" time="220" tween="back" easing="out">Visible</animation>
				</control>

				<control type="group">
					<description>Album cover (square) or show / season poster, with a fallback card</description>
					<left>30</left>
					<top>88</top>
					<control type="group">
						<visible>String.IsEqual(Window.Property(shape),square)</visible>
						<control type="image" id="161">
							<width>420</width>
							<height>420</height>
							<texture colordiffuse="FF1A1A1F">kscape-white.png</texture>
						</control>
						<control type="textbox" id="162">
							<left>24</left>
							<top>24</top>
							<width>372</width>
							<height>372</height>
							<align>center</align>
							<aligny>center</aligny>
							<font>kscape_panel_title</font>
							<textcolor>FFC8C8D0</textcolor>
							<label>$INFO[Window.Property(title)]</label>
							<visible>String.IsEmpty(Window.Property(art))</visible>
						</control>
						<control type="image" id="163">
							<width>420</width>
							<height>420</height>
							<aspectratio>scale</aspectratio>
							<fadetime>150</fadetime>
							<texture background="true">$INFO[Window.Property(art)]</texture>
						</control>
					</control>
					<control type="group">
						<visible>String.IsEqual(Window.Property(shape),poster)</visible>
						<control type="image" id="171">
							<width>420</width>
							<height>630</height>
							<texture colordiffuse="FF1A1A1F">kscape-white.png</texture>
						</control>
						<control type="textbox" id="172">
							<left>24</left>
							<top>24</top>
							<width>372</width>
							<height>582</height>
							<align>center</align>
							<aligny>center</aligny>
							<font>kscape_panel_title</font>
							<textcolor>FFC8C8D0</textcolor>
							<label>$INFO[Window.Property(title)]</label>
							<visible>String.IsEmpty(Window.Property(art))</visible>
						</control>
						<control type="image" id="173">
							<width>420</width>
							<height>630</height>
							<aspectratio>scale</aspectratio>
							<fadetime>150</fadetime>
							<texture background="true">$INFO[Window.Property(art)]</texture>
						</control>
					</control>
				</control>

				<control type="button" id="901">
					<description>Edge target: never visible, so the lists stop at their ends</description>
					<left>-200</left>
					<top>-200</top>
					<width>1</width>
					<height>1</height>
					<texturefocus/>
					<texturenofocus/>
					<visible>false</visible>
				</control>

				<control type="list" id="100">
					<description>Return / Play Album, or Return / Play next episode</description>
					<top>734</top>
					<width>480</width>
					<height>240</height>
					<onup>901</onup>
					<ondown>901</ondown>
					<onleft>901</onleft>
					<onright>300</onright>
					<scrolltime>0</scrolltime>
					<itemlayout width="480" height="60">
						<control type="label">
							<left>30</left>
							<width>300</width>
							<height>60</height>
							<aligny>center</aligny>
							<font>kscape_menu</font>
							<textcolor>kscape_tint_light</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<left>300</left>
							<width>150</width>
							<height>60</height>
							<align>right</align>
							<aligny>center</aligny>
							<font>kscape_small</font>
							<textcolor>kscape_text_dim</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</itemlayout>
					<focusedlayout width="480" height="60">
						<control type="image">
							<width>480</width>
							<height>60</height>
							<texture colordiffuse="kscape_blue_light">kscape-white.png</texture>
							<visible>Control.HasFocus(100)</visible>
						</control>
						<control type="label">
							<left>30</left>
							<width>300</width>
							<height>60</height>
							<aligny>center</aligny>
							<font>kscape_menu</font>
							<textcolor>FFFFFFFF</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<left>300</left>
							<width>150</width>
							<height>60</height>
							<align>right</align>
							<aligny>center</aligny>
							<font>kscape_small</font>
							<textcolor>FFFFFFFF</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</focusedlayout>
				</control>

				<control type="textbox" id="210">
					<description>Facts: artist, year, genres, tracks / network, rating, episodes</description>
					<left>530</left>
					<top>88</top>
					<width>1150</width>
					<height>76</height>
					<font>kscape_panel_body</font>
					<textcolor>kscape_text</textcolor>
				</control>
				<control type="textbox" id="221">
					<description>Album review or show plot</description>
					<left>530</left>
					<top>186</top>
					<width>1150</width>
					<height>152</height>
					<font>kscape_panel_body</font>
					<textcolor>kscape_tint_light</textcolor>
					<autoscroll delay="6000" time="3000" repeat="8000">true</autoscroll>
				</control>
				<control type="label" id="230">
					<description>Tracks / Seasons / Episodes</description>
					<left>530</left>
					<top>360</top>
					<width>1150</width>
					<height>44</height>
					<font>kscape_info_label</font>
					<textcolor>FFFFFFFF</textcolor>
				</control>

				<control type="list" id="300">
					<description>Tracks, seasons or episodes</description>
					<left>510</left>
					<top>408</top>
					<width>1190</width>
					<height>546</height>
					<onup>901</onup>
					<ondown>901</ondown>
					<onleft>100</onleft>
					<onright>901</onright>
					<scrolltime tween="cubic" easing="out">200</scrolltime>
					<itemlayout width="1190" height="84">
						<control type="image">
							<description>Unwatched</description>
							<left>8</left>
							<top>36</top>
							<width>12</width>
							<height>12</height>
							<texture colordiffuse="kscape_amber">kscape-white.png</texture>
							<visible>String.IsEqual(ListItem.Property(unwatched),1)</visible>
						</control>
						<control type="image">
							<left>28</left>
							<top>6</top>
							<width>128</width>
							<height>72</height>
							<aspectratio>keep</aspectratio>
							<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
							<visible>!String.IsEmpty(ListItem.Art(thumb))</visible>
						</control>
						<control type="label">
							<left>28</left>
							<width>900</width>
							<height>84</height>
							<aligny>center</aligny>
							<font>kscape_menu</font>
							<textcolor>kscape_tint_row</textcolor>
							<label>$INFO[ListItem.Label]$INFO[ListItem.Property(detail),[COLOR kscape_text_dim]   ,[/COLOR]]</label>
							<visible>String.IsEmpty(ListItem.Art(thumb))</visible>
						</control>
						<control type="label">
							<left>176</left>
							<width>752</width>
							<height>84</height>
							<aligny>center</aligny>
							<font>kscape_menu</font>
							<textcolor>kscape_tint_row</textcolor>
							<label>$INFO[ListItem.Label]$INFO[ListItem.Property(detail),[COLOR kscape_text_dim]   ,[/COLOR]]</label>
							<visible>!String.IsEmpty(ListItem.Art(thumb))</visible>
						</control>
						<control type="label">
							<left>940</left>
							<width>226</width>
							<height>84</height>
							<align>right</align>
							<aligny>center</aligny>
							<font>kscape_small</font>
							<textcolor>kscape_text_dim</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</itemlayout>
					<focusedlayout width="1190" height="84">
						<control type="image">
							<width>1190</width>
							<height>84</height>
							<texture colordiffuse="kscape_blue_light">kscape-white.png</texture>
							<visible>Control.HasFocus(300)</visible>
						</control>
						<control type="image">
							<width>1190</width>
							<height>84</height>
							<texture colordiffuse="kscape_blue_mid">kscape-white.png</texture>
							<visible>!Control.HasFocus(300)</visible>
						</control>
						<control type="image">
							<left>8</left>
							<top>36</top>
							<width>12</width>
							<height>12</height>
							<texture colordiffuse="kscape_amber">kscape-white.png</texture>
							<visible>String.IsEqual(ListItem.Property(unwatched),1)</visible>
						</control>
						<control type="image">
							<left>28</left>
							<top>6</top>
							<width>128</width>
							<height>72</height>
							<aspectratio>keep</aspectratio>
							<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
							<visible>!String.IsEmpty(ListItem.Art(thumb))</visible>
						</control>
						<control type="label">
							<left>28</left>
							<width>900</width>
							<height>84</height>
							<aligny>center</aligny>
							<font>kscape_menu</font>
							<textcolor>FFFFFFFF</textcolor>
							<label>$INFO[ListItem.Label]$INFO[ListItem.Property(detail),[COLOR kscape_tint_light]   ,[/COLOR]]</label>
							<visible>String.IsEmpty(ListItem.Art(thumb))</visible>
						</control>
						<control type="label">
							<left>176</left>
							<width>752</width>
							<height>84</height>
							<aligny>center</aligny>
							<font>kscape_menu</font>
							<textcolor>FFFFFFFF</textcolor>
							<label>$INFO[ListItem.Label]$INFO[ListItem.Property(detail),[COLOR kscape_tint_light]   ,[/COLOR]]</label>
							<visible>!String.IsEmpty(ListItem.Art(thumb))</visible>
						</control>
						<control type="label">
							<left>940</left>
							<width>226</width>
							<height>84</height>
							<align>right</align>
							<aligny>center</aligny>
							<font>kscape_small</font>
							<textcolor>FFFFFFFF</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</focusedlayout>
				</control>
			</control>
	
		</control>
	</controls>
</window>
