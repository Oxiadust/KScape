						<textcolor>white</textcolor>
						<scroll>true</scroll>
						<label>$INFO[ListItem.Label]</label>
						<visible>Control.HasFocus(20) | !ListItem.IsSelected</visible>
					</control>
					<control type="label">
						<left>82</left>
						<width>520</width>
						<height>65</height>
						<aligny>center</aligny>
						<font>kscape_list_value</font>
						<textcolor>kscape_amber</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>!Control.HasFocus(20) + ListItem.IsSelected</visible>
					</control>
					<control type="label">
						<left>612</left>
						<width>164</width>
						<height>65</height>
						<align>right</align>
						<aligny>center</aligny>
						<font>kscape_small</font>
						<textcolor>white</textcolor>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</focusedlayout>
			</control>
			<control type="scrollbar" id="60">
				<left>14</left>
				<top>142</top>
				<width>12</width>
				<height>780</height>
				<orientation>vertical</orientation>
				<onleft>20</onleft>
				<onright>20</onright>
