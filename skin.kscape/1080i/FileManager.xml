<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi contract (File manager): 20 left list, 21 right list, 101 left path label, 102 right path
     label (set by Kodi). 60/61 are the lists' scrollbars. Items marked for copy/move/delete
     (ListItem.IsSelected) are shown in amber. -->
<window>
	<defaultcontrol always="true">20</defaultcontrol>
	<controls>
		<include>SystemBackdrop</include>
		<control type="group">
			<left>96</left>
			<top>48</top>
			<include>WindowFade</include>
			<include content="SystemPanel">
				<param name="width" value="1728"/>
				<param name="height" value="984"/>
				<param name="title" value="$LOCALIZE[7]"/>
			</include>
			<control type="image">
				<left>36</left>
				<top>132</top>
				<width>816</width>
				<height>800</height>
				<texture colordiffuse="kscape_blue_dark">white.png</texture>
			</control>
			<control type="label" id="101">
				<description>Left path, set by Kodi</description>
				<left>46</left>
				<top>72</top>
				<width>590</width>
				<height>56</height>
				<aligny>center</aligny>
				<font>kscape_info_label</font>
				<textcolor>white</textcolor>
				<haspath>true</haspath>
			</control>
			<control type="label">
				<left>646</left>
				<top>72</top>
				<width>196</width>
				<height>56</height>
				<align>right</align>
				<aligny>center</aligny>
				<font>kscape_list_value</font>
				<textcolor>kscape_text_dim</textcolor>
				<label>$INFO[Container(20).CurrentItem,, / ]$INFO[Container(20).NumItems]</label>
			</control>
			<control type="list" id="20">
				<left>46</left>
				<top>142</top>
				<width>796</width>
				<height>780</height>
				<onleft>60</onleft>
				<onright>21</onright>
				<onup>20</onup>
				<ondown>20</ondown>
				<pagecontrol>60</pagecontrol>
				<scrolltime>200</scrolltime>
				<itemlayout width="796" height="65">
					<control type="image">
						<description>Amber marker on items selected for copy/move/delete</description>
						<width>8</width>
						<height>65</height>
						<texture colordiffuse="kscape_amber">white.png</texture>
						<visible>ListItem.IsSelected</visible>
					</control>
					<control type="image">
						<left>20</left>
						<top>10</top>
						<width>45</width>
						<height>45</height>
						<aspectratio>keep</aspectratio>
						<texture>$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>82</left>
						<width>520</width>
						<height>65</height>
						<aligny>center</aligny>
						<font>kscape_list_value</font>
						<textcolor>kscape_text</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>!ListItem.IsSelected</visible>
					</control>
					<control type="label">
						<left>82</left>
						<width>520</width>
						<height>65</height>
						<aligny>center</aligny>
						<font>kscape_list_value</font>
						<textcolor>kscape_amber</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>ListItem.IsSelected</visible>
					</control>
					<control type="label">
						<left>612</left>
						<width>164</width>
						<height>65</height>
						<align>right</align>
						<aligny>center</aligny>
						<font>kscape_small</font>
						<textcolor>kscape_text_dim</textcolor>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</itemlayout>
				<focusedlayout width="796" height="65">
					<control type="image">
						<width>796</width>
						<height>65</height>
						<texture colordiffuse="kscape_blue_focus">white.png</texture>
						<visible>Control.HasFocus(20)</visible>
					</control>
					<control type="image">
						<description>Amber marker on items selected for copy/move/delete</description>
						<width>8</width>
						<height>65</height>
						<texture colordiffuse="kscape_amber">white.png</texture>
						<visible>ListItem.IsSelected</visible>
