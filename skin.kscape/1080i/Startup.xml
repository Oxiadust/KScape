<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi always starts on Home. The wall add-on is only told to sync its colour theme with the
     skin settings; it opens a view when you choose one on Home. -->
<window>
	<onload>ReplaceWindow(Home)</onload>
	<onload condition="System.AddonIsEnabled(script.kscape.wall)">RunScript(script.kscape.wall,startup)</onload>
	<controls/>
</window>
