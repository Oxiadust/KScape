<?xml version="1.0" encoding="UTF-8"?>
<!-- Info during playback: title, year, runtime and synopsis of the playing movie. -->
<window>
	<depth>DepthOSD</depth>
	<controls>
		<control type="group">
			<description>Display &amp; aspect ratio root (Includes_Display.xml)</description>
			<include>KScapeDisplay</include>
			<control type="group">
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="140">WindowClose</animation>
				<control type="image">
					<top>700</top>
					<width>1920</width>
					<height>380</height>
					<texture colordiffuse="D8060607">white.png</texture>
				</control>
				<control type="label">
					<left>120</left>
					<top>740</top>
					<width>1400</width>
					<height>56</height>
					<font>kscape_panel_title</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[VideoPlayer.Title]</label>
				</control>
				<control type="label">
					<left>120</left>
					<top>800</top>
					<width>1680</width>
					<height>40</height>
					<font>kscape_small</font>
					<textcolor>FF9A9AA2</textcolor>
					<label>$INFO[VideoPlayer.Year]$INFO[VideoPlayer.Genre,   ·   ]$INFO[Player.Duration,   ·   ]</label>
				</control>
				<control type="textbox">
					<left>120</left>
					<top>860</top>
					<width>1680</width>
					<height>160</height>
					<font>kscape13</font>
					<textcolor>FFD8D8E0</textcolor>
					<label>$INFO[VideoPlayer.Plot]</label>
				</control>
			</control>
	
		</control>
	</controls>
</window>
