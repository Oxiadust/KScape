<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- Skin settings: the colour theme, as script.kscape.wall last recorded it (default until then). -->
	<variable name="KScapeColourMainLabel">
		<value condition="!String.IsEmpty(Skin.String(KScapeColourMain))">$INFO[Skin.String(KScapeColourMain)]</value>
		<value>$ADDON[script.kscape.wall 32190]</value>
	</variable>
	<variable name="KScapeColourHighlightLabel">
		<value condition="!String.IsEmpty(Skin.String(KScapeColourHighlight))">$INFO[Skin.String(KScapeColourHighlight)]</value>
		<value>$ADDON[script.kscape.wall 32196]</value>
	</variable>

	<variable name="PosterArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>

	<variable name="PosterFallbackLabel">
		<value condition="ListItem.IsParentFolder">..</value>
		<value>$INFO[ListItem.Label]$INFO[ListItem.Year,[CR](,)]</value>
	</variable>

	<!-- Bottom strip: focused title, then metadata ordered so genre (least important) truncates first. -->
	<variable name="WallTitleLabel">
		<value condition="Container(50).ListItem.IsParentFolder">$LOCALIZE[31013]</value>
		<value>$INFO[Container(50).ListItem.Label]</value>
	</variable>

	<variable name="WallMetaLabel">
		<value condition="Container(50).ListItem.IsParentFolder"></value>
		<value>$INFO[Container(50).ListItem.Year,   ]$INFO[Container(50).ListItem.Duration(mins),   ·   , $LOCALIZE[31014]]$INFO[Container(50).ListItem.Genre,   ·   ]</value>
	</variable>

	<!-- Playback controls -->
	<variable name="OSDPlayPauseLabel">
		<value condition="Player.Paused">$LOCALIZE[31020]</value>
		<value>$LOCALIZE[31021]</value>
	</variable>

	<variable name="OSDAudioLabel">
		<!-- "und" is the ISO code for an untagged track: show plain "Audio" instead. -->
		<value condition="!String.IsEmpty(VideoPlayer.AudioLanguage) + !String.IsEqual(VideoPlayer.AudioLanguage,und)">$LOCALIZE[31024]: $INFO[VideoPlayer.AudioLanguage]</value>
		<value>$LOCALIZE[31024]</value>
	</variable>

	<variable name="OSDSubtitleLabel">
		<!-- Kodi reports subtitles "enabled" even for files without any, so also require a track. -->
		<value condition="VideoPlayer.HasSubtitles + VideoPlayer.SubtitlesEnabled + !String.IsEmpty(VideoPlayer.SubtitlesLanguage)">$LOCALIZE[31025]: $INFO[VideoPlayer.SubtitlesLanguage]</value>
		<value condition="VideoPlayer.HasSubtitles + VideoPlayer.SubtitlesEnabled">$LOCALIZE[31025]: $LOCALIZE[31028]</value>
		<value>$LOCALIZE[31025]: $LOCALIZE[31026]</value>
	</variable>
</includes>
