				<onright condition="String.IsEqual(Container(9100).ListItem.Property(id),general)">9201</onright>
				<onright condition="String.IsEqual(Container(9100).ListItem.Property(id),colours)">9202</onright>
				<onright condition="String.IsEqual(Container(9100).ListItem.Property(id),home)">9203</onright>
