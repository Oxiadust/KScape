<?xml version="1.0" encoding="UTF-8"?>
<!-- Skin settings window (WINDOW_SKIN_SETTINGS). Kodi contract: none; all ids here are KScape's own.
     Categories on the left (9100), the selected one's settings on the right (9201-9205):
     General      Skin.HasSetting(ReducedMotion)
     Colours      the theme's main and highlight colour, picked by script.kscape.wall (colours.py), which
                  sets Kodi's skin colours setting (colors/*.xml, made by tools/gen_colors.py)
     Home         Skin.HasSetting(HomeNoArtwork | HomeNoClock | HomeNoCaption)
     Movie versions  Skin.HasSetting(KScapeHideFormatBadges | KScapePrefer3D),
                  Skin.String(KScapeVersionPreference) (versionsui.py)
     Display & aspect ratio  Skin.String(KScapeAspect | KScapeScopeRows | KScapeVOffset | KScapeHOffset |
                  KScapeSafeArea), chosen, previewed and confirmed by displayui.py; the *Label strings
                  are what the rows show. -->
<window>
	<defaultcontrol always="true">9100</defaultcontrol>
	<controls>
		<control type="group">
			<description>Display &amp; aspect ratio root (Includes_Display.xml)</description>
			<include>KScapeDisplay</include>
		<include>SystemBackdrop</include>
