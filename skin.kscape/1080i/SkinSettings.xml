						<height>72</height>
						<aligny>center</aligny>
						<font>kscape_menu</font>
						<textcolor>kscape_tint_light</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="400" height="72">
