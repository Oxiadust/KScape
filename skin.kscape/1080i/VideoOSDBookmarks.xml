<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi contract (video bookmarks, from the playback controls or the B key): 11 bookmarks
     (Select jumps there, C removes), 2 Add bookmark, 3 Clear bookmarks, 4 Add episode bookmark
     (when Kodi enables it). Drawn over the video, along the bottom of the screen. -->
<window>
	<defaultcontrol always="true">2</defaultcontrol>
	<depth>DepthOSD</depth>
	<controls>
		<control type="group">
			<description>Display &amp; aspect ratio root (Includes_Display.xml)</description>
			<include>KScapeDisplay</include>
			<control type="button">
				<description>Select outside the panel closes it</description>
				<width>1920</width>
				<height>1080</height>
				<texturefocus/>
				<texturenofocus/>
				<onclick>Action(close)</onclick>
			</control>
			<control type="group">
				<top>560</top>
				<include>PanelOpenClose</include>
				<control type="image">
					<width>1920</width>
					<height>520</height>
					<texture colordiffuse="kscape_bg_shade">white.png</texture>
				</control>
				<control type="image">
					<width>1920</width>
					<height>4</height>
					<texture colordiffuse="kscape_blue">white.png</texture>
				</control>
				<control type="grouplist" id="9001">
					<left>60</left>
					<top>30</top>
					<width>1800</width>
					<height>70</height>
					<orientation>horizontal</orientation>
					<itemgap>16</itemgap>
					<onup>11</onup>
					<ondown>11</ondown>
					<control type="button" id="2">
						<align>center</align>
						<textoffsetx>0</textoffsetx>
						<include content="SystemButton">
							<param name="width" value="360"/>
							<param name="height" value="70"/>
						</include>
						<label>$LOCALIZE[294]</label>
					</control>
					<control type="button" id="3">
						<align>center</align>
						<textoffsetx>0</textoffsetx>
						<include content="SystemButton">
							<param name="width" value="360"/>
							<param name="height" value="70"/>
						</include>
						<label>$LOCALIZE[296]</label>
					</control>
					<control type="button" id="4">
						<align>center</align>
						<textoffsetx>0</textoffsetx>
						<include content="SystemButton">
							<param name="width" value="420"/>
							<param name="height" value="70"/>
						</include>
						<label>$LOCALIZE[20406]</label>
						<visible>Control.IsEnabled(4)</visible>
					</control>
				</control>
				<control type="label">
					<left>60</left>
					<top>200</top>
					<width>1800</width>
					<height>60</height>
					<align>center</align>
					<font>kscape_menu</font>
					<textcolor>kscape_text_dim</textcolor>
					<label>$LOCALIZE[31058]</label>
					<visible>Integer.IsEqual(Container(11).NumItems,0)</visible>
				</control>
				<control type="panel" id="11">
					<left>50</left>
					<top>130</top>
					<width>1820</width>
					<height>330</height>
					<orientation>horizontal</orientation>
					<onup>9001</onup>
					<ondown>9001</ondown>
					<preloaditems>2</preloaditems>
					<scrolltime tween="cubic" easing="out">200</scrolltime>
					<itemlayout width="380" height="320">
						<control type="image">
							<left>10</left>
							<top>10</top>
							<width>340</width>
							<height>230</height>
							<texture colordiffuse="kscape_blue_dark">white.png</texture>
						</control>
						<control type="image">
							<left>10</left>
							<top>10</top>
							<width>340</width>
							<height>230</height>
							<aspectratio>scale</aspectratio>
							<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
						</control>
						<control type="label">
							<top>252</top>
							<width>360</width>
							<height>36</height>
							<align>center</align>
							<font>kscape_menu</font>
							<textcolor>kscape_text</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<top>286</top>
							<width>360</width>
							<height>30</height>
							<align>center</align>
							<font>kscape_small</font>
							<textcolor>kscape_text_dim</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</itemlayout>
					<focusedlayout width="380" height="320">
						<control type="image">
							<width>360</width>
							<height>250</height>
							<texture colordiffuse="kscape_amber">white.png</texture>
							<visible>Control.HasFocus(11)</visible>
						</control>
						<control type="image">
							<left>10</left>
							<top>10</top>
							<width>340</width>
							<height>230</height>
							<texture colordiffuse="kscape_blue_dark">white.png</texture>
						</control>
						<control type="image">
							<left>10</left>
							<top>10</top>
							<width>340</width>
							<height>230</height>
							<aspectratio>scale</aspectratio>
							<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
						</control>
						<control type="label">
							<top>252</top>
							<width>360</width>
							<height>36</height>
							<align>center</align>
							<font>kscape_menu</font>
							<textcolor>white</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<top>286</top>
							<width>360</width>
							<height>30</height>
							<align>center</align>
							<font>kscape_small</font>
							<textcolor>kscape_text_dim</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</focusedlayout>
				</control>
			</control>
	
		</control>
	</controls>
</window>
