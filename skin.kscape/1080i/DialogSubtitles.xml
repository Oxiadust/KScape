<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi contract (subtitle search and download, from the playback controls): 100 heading,
     120 subtitles found (Label language, Label2 name; properties sync and hearing_imp),
     73 its scrollbar, 150 subtitle services, 110 the service's logo, 140 status text,
     160 manual search, 130 "Local subtitle available" (shown by Kodi), 250 the panel. -->
<window>
	<defaultcontrol always="true">150</defaultcontrol>
	<depth>DepthOSD</depth>
	<controls>
		<control type="group">
			<description>Display &amp; aspect ratio root (Includes_Display.xml)</description>
			<include>KScapeDisplay</include>
			<include>DialogDim</include>
			<control type="group" id="250">
				<left>100</left>
				<top>150</top>
				<include>PanelOpenClose</include>
				<include content="SystemPanel">
					<param name="width" value="1720"/>
					<param name="height" value="780"/>
					<param name="title"></param>
				</include>
				<control type="label" id="100">
					<left>30</left>
					<width>1660</width>
					<height>64</height>
					<aligny>center</aligny>
					<font>kscape_info_head</font>
					<textcolor>white</textcolor>
					<label>$LOCALIZE[24012]</label>
				</control>
				<control type="label">
					<description>The video</description>
					<left>30</left>
					<top>76</top>
					<width>1660</width>
					<height>40</height>
					<aligny>center</aligny>
					<font>kscape_small</font>
					<textcolor>kscape_text_dim</textcolor>
					<scroll>true</scroll>
					<label>$INFO[Player.Filename]</label>
				</control>
				<control type="label">
					<left>30</left>
					<top>124</top>
					<width>360</width>
					<height>40</height>
					<aligny>center</aligny>
					<font>kscape_info_label</font>
					<textcolor>white</textcolor>
					<label>$LOCALIZE[24018]</label>
				</control>
				<control type="image">
					<left>30</left>
					<top>170</top>
					<width>360</width>
					<height>420</height>
					<texture colordiffuse="kscape_blue_dark">white.png</texture>
				</control>
				<control type="list" id="150">
					<description>Subtitle services</description>
					<left>30</left>
					<top>170</top>
					<width>360</width>
					<height>420</height>
					<onleft>120</onleft>
					<onright>120</onright>
					<onup>150</onup>
					<ondown>160</ondown>
					<scrolltime>200</scrolltime>
					<include content="SystemListRow">
						<param name="id" value="150"/>
						<param name="width" value="360"/>
						<param name="height" value="64"/>
					</include>
				</control>
				<control type="image" id="110">
					<description>Service logo</description>
					<left>30</left>
					<top>600</top>
					<width>160</width>
					<height>70</height>
					<aspectratio aligny="center">keep</aspectratio>
					<fadetime>200</fadetime>
				</control>
				<control type="button" id="160">
					<description>Manual search</description>
					<left>30</left>
					<top>680</top>
					<align>center</align>
					<textoffsetx>0</textoffsetx>
					<include content="SystemButton">
						<param name="width" value="360"/>
						<param name="height" value="70"/>
					</include>
					<label>$LOCALIZE[24120]</label>
					<onup>150</onup>
					<ondown>150</ondown>
					<onleft>120</onleft>
					<onright>120</onright>
				</control>
				<control type="image">
					<left>420</left>
					<top>124</top>
					<width>1270</width>
					<height>626</height>
					<texture colordiffuse="kscape_blue_dark">white.png</texture>
				</control>
				<control type="list" id="120">
					<description>Subtitles found</description>
					<left>420</left>
					<top>124</top>
					<width>1250</width>
					<height>626</height>
					<onleft>150</onleft>
					<onright>73</onright>
					<onup>120</onup>
					<ondown>120</ondown>
					<pagecontrol>73</pagecontrol>
					<scrolltime>200</scrolltime>
					<itemlayout width="1250" height="78">
						<control type="label">
							<left>24</left>
							<width>260</width>
							<height>78</height>
							<aligny>center</aligny>
							<font>kscape_list_value</font>
							<textcolor>kscape_text_dim</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<left>290</left>
							<width>800</width>
							<height>78</height>
							<aligny>center</aligny>
							<font>kscape_list_value</font>
							<textcolor>kscape_text</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
						<control type="label">
							<left>1100</left>
							<width>130</width>
							<height>78</height>
							<align>right</align>
							<aligny>center</aligny>
							<font>kscape_small</font>
							<textcolor>kscape_amber</textcolor>
							<label>$VAR[KScapeSubtitleFlags]</label>
						</control>
					</itemlayout>
					<focusedlayout width="1250" height="78">
						<control type="image">
							<width>1250</width>
							<height>78</height>
							<texture colordiffuse="kscape_blue_focus">white.png</texture>
							<animation effect="fade" start="100" end="40" time="0" condition="!Control.HasFocus(120)">Conditional</animation>
						</control>
						<control type="label">
							<left>24</left>
							<width>260</width>
							<height>78</height>
							<aligny>center</aligny>
							<font>kscape_list_value</font>
							<textcolor>white</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<left>290</left>
							<width>800</width>
							<height>78</height>
							<aligny>center</aligny>
							<font>kscape_list_value</font>
							<textcolor>white</textcolor>
							<scroll>true</scroll>
							<label>$INFO[ListItem.Label2]</label>
						</control>
						<control type="label">
							<left>1100</left>
							<width>130</width>
							<height>78</height>
							<align>right</align>
							<aligny>center</aligny>
							<font>kscape_small</font>
							<textcolor>white</textcolor>
							<label>$VAR[KScapeSubtitleFlags]</label>
						</control>
					</focusedlayout>
				</control>
				<control type="scrollbar" id="73">
					<left>1674</left>
					<top>124</top>
					<width>12</width>
					<height>626</height>
					<orientation>vertical</orientation>
					<onleft>120</onleft>
					<onright>150</onright>
					<texturesliderbackground colordiffuse="kscape_blue">white.png</texturesliderbackground>
					<texturesliderbar colordiffuse="kscape_text_dim">white.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="white">white.png</texturesliderbarfocus>
					<textureslidernib/>
					<textureslidernibfocus/>
				</control>
				<control type="label" id="140">
					<description>Status (searching, nothing found...), set by Kodi</description>
					<left>440</left>
					<top>380</top>
					<width>1230</width>
					<height>120</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>kscape_menu</font>
					<textcolor>kscape_text_dim</textcolor>
					<wrapmultiline>true</wrapmultiline>
				</control>
				<control type="grouplist" id="130">
					<description>Local subtitle available (Kodi shows it)</description>
					<left>440</left>
					<top>690</top>
					<width>1230</width>
					<height>50</height>
					<orientation>horizontal</orientation>
					<control type="label">
						<width>auto</width>
						<height>50</height>
						<aligny>center</aligny>
						<font>kscape_small</font>
						<textcolor>kscape_amber</textcolor>
						<label>$LOCALIZE[31061]</label>
					</control>
				</control>
			</control>
	
		</control>
	</controls>
</window>
