<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi contract (Add/edit media source): 2 heading, 10 path list, 11 browse, 13 add path,
     14 remove path, 12 name edit, 18 OK, 19 cancel. 60 scrollbar and 9000/9001 grouplists are skin-side. -->
<window>
	<defaultcontrol>10</defaultcontrol>
	<depth>DepthDialog</depth>
	<controls>
		<control type="group">
			<description>Display &amp; aspect ratio root (Includes_Display.xml)</description>
			<include>KScapeDisplay</include>
			<include>DialogDim</include>
			<control type="group">
				<left>310</left>
				<top>160</top>
				<include>PanelOpenClose</include>
				<include content="SystemPanel">
					<param name="width" value="1300"/>
					<param name="height" value="760"/>
					<param name="title"></param>
				</include>
				<control type="label" id="2">
					<description>Heading, set by Kodi</description>
					<left>30</left>
					<width>1240</width>
					<height>64</height>
					<aligny>center</aligny>
					<font>kscape_info_head</font>
					<textcolor>white</textcolor>
				</control>
				<control type="label">
					<left>30</left>
					<top>84</top>
					<width>1240</width>
					<height>40</height>
					<aligny>center</aligny>
					<font>kscape_list_value</font>
					<textcolor>kscape_text_dim</textcolor>
					<label>$LOCALIZE[1021]</label>
				</control>
				<control type="image">
					<left>30</left>
					<top>136</top>
					<width>900</width>
					<height>300</height>
					<texture colordiffuse="kscape_blue_dark">white.png</texture>
				</control>
				<control type="list" id="10">
					<description>Paths</description>
					<left>30</left>
					<top>146</top>
					<width>880</width>
					<height>280</height>
					<onup>9001</onup>
					<onleft>9000</onleft>
					<onright>60</onright>
					<ondown>12</ondown>
					<pagecontrol>60</pagecontrol>
					<scrolltime>200</scrolltime>
					<itemlayout width="880" height="70">
						<control type="label">
							<left>24</left>
							<width>832</width>
							<height>70</height>
							<aligny>center</aligny>
							<font>kscape_list_value</font>
							<textcolor>kscape_text</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
					</itemlayout>
					<focusedlayout width="880" height="70">
						<control type="image">
							<description>Half-lit while the buttons have focus, marking the path they act on</description>
							<width>880</width>
							<height>70</height>
							<texture colordiffuse="kscape_blue_focus">white.png</texture>
							<animation effect="fade" start="100" end="40" time="0" condition="!Control.HasFocus(10)">Conditional</animation>
						</control>
						<control type="label">
							<left>24</left>
							<width>832</width>
							<height>70</height>
							<aligny>center</aligny>
							<font>kscape_list_value</font>
							<textcolor>white</textcolor>
							<scroll>true</scroll>
							<label>$INFO[ListItem.Label]</label>
						</control>
					</focusedlayout>
				</control>
				<control type="scrollbar" id="60">
					<left>914</left>
					<top>146</top>
					<width>12</width>
					<height>280</height>
					<orientation>vertical</orientation>
					<onleft>10</onleft>
					<onright>9000</onright>
					<texturesliderbackground colordiffuse="kscape_blue">white.png</texturesliderbackground>
					<texturesliderbar colordiffuse="kscape_text_dim">white.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="white">white.png</texturesliderbarfocus>
					<textureslidernib/>
					<textureslidernibfocus/>
				</control>
				<control type="grouplist" id="9000">
					<left>950</left>
					<top>136</top>
					<width>320</width>
					<height>300</height>
					<orientation>vertical</orientation>
					<itemgap>10</itemgap>
					<onleft>10</onleft>
					<onright>10</onright>
					<ondown>12</ondown>
					<control type="button" id="11">
						<description>Browse</description>
						<width>320</width>
						<height>80</height>
						<font>kscape_menu</font>
						<align>center</align>
						<aligny>center</aligny>
						<textcolor>kscape_text</textcolor>
						<focusedcolor>white</focusedcolor>
						<disabledcolor>kscape_text_off</disabledcolor>
						<texturefocus colordiffuse="kscape_blue_focus">white.png</texturefocus>
						<texturenofocus colordiffuse="kscape_blue_dark">white.png</texturenofocus>
						<label>$LOCALIZE[1024]</label>
					</control>
					<control type="button" id="13">
						<description>Add path</description>
						<width>320</width>
						<height>80</height>
						<font>kscape_menu</font>
						<align>center</align>
						<aligny>center</aligny>
						<textcolor>kscape_text</textcolor>
						<focusedcolor>white</focusedcolor>
						<disabledcolor>kscape_text_off</disabledcolor>
						<texturefocus colordiffuse="kscape_blue_focus">white.png</texturefocus>
						<texturenofocus colordiffuse="kscape_blue_dark">white.png</texturenofocus>
						<label>$LOCALIZE[15019]</label>
					</control>
					<control type="button" id="14">
						<description>Remove path</description>
						<width>320</width>
						<height>80</height>
						<font>kscape_menu</font>
						<align>center</align>
						<aligny>center</aligny>
						<textcolor>kscape_text</textcolor>
						<focusedcolor>white</focusedcolor>
						<disabledcolor>kscape_text_off</disabledcolor>
						<texturefocus colordiffuse="kscape_blue_focus">white.png</texturefocus>
						<texturenofocus colordiffuse="kscape_blue_dark">white.png</texturenofocus>
						<label>$LOCALIZE[1210]</label>
					</control>
				</control>
				<control type="label">
					<left>30</left>
					<top>456</top>
					<width>1240</width>
					<height>40</height>
					<aligny>center</aligny>
					<font>kscape_list_value</font>
					<textcolor>kscape_text_dim</textcolor>
					<label>$LOCALIZE[1022]</label>
				</control>
				<control type="edit" id="12">
					<description>Source name</description>
					<left>30</left>
					<top>504</top>
					<width>1240</width>
					<height>80</height>
					<aligny>center</aligny>
					<textoffsetx>24</textoffsetx>
					<font>kscape_panel_body</font>
					<textcolor>kscape_text</textcolor>
					<focusedcolor>white</focusedcolor>
					<disabledcolor>kscape_text_off</disabledcolor>
					<texturefocus colordiffuse="kscape_blue_focus">white.png</texturefocus>
					<texturenofocus colordiffuse="kscape_blue_dark">white.png</texturenofocus>
					<label></label>
					<onup>10</onup>
					<ondown>9001</ondown>
				</control>
				<control type="grouplist" id="9001">
					<top>630</top>
					<width>1300</width>
					<height>80</height>
					<orientation>horizontal</orientation>
					<align>center</align>
					<itemgap>20</itemgap>
					<onup>12</onup>
					<control type="button" id="18">
						<description>OK</description>
						<width>300</width>
						<height>80</height>
						<font>kscape_menu</font>
						<align>center</align>
						<aligny>center</aligny>
						<textcolor>kscape_text</textcolor>
						<focusedcolor>white</focusedcolor>
						<disabledcolor>kscape_text_off</disabledcolor>
						<texturefocus colordiffuse="kscape_blue_focus">white.png</texturefocus>
						<texturenofocus colordiffuse="kscape_blue_dark">white.png</texturenofocus>
						<label>$LOCALIZE[186]</label>
					</control>
					<control type="button" id="19">
						<description>Cancel</description>
						<width>300</width>
						<height>80</height>
						<font>kscape_menu</font>
						<align>center</align>
						<aligny>center</aligny>
						<textcolor>kscape_text</textcolor>
						<focusedcolor>white</focusedcolor>
						<disabledcolor>kscape_text_off</disabledcolor>
						<texturefocus colordiffuse="kscape_blue_focus">white.png</texturefocus>
						<texturenofocus colordiffuse="kscape_blue_dark">white.png</texturenofocus>
						<label>$LOCALIZE[222]</label>
					</control>
				</control>
			</control>
	
		</control>
	</controls>
</window>
