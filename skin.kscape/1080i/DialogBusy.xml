<?xml version="1.0" encoding="UTF-8"?>
<window>
	<depth>DepthMax</depth>
	<controls>
		<control type="group">
			<description>Display &amp; aspect ratio root (Includes_Display.xml)</description>
			<include>KScapeDisplay</include>
			<control type="group">
				<visible>!Window.IsActive(startup)</visible>
				<left>760</left>
				<top>500</top>
				<animation effect="fade" start="0" end="100" delay="450" time="400">Visible</animation>
				<control type="image">
					<description>KScape logo, breathing; fades in only if the wait outlasts 450 ms</description>
					<width>400</width>
					<height>75</height>
					<aspectratio>keep</aspectratio>
					<texture>kscape-logo.png</texture>
					<animation effect="fade" start="100" end="35" time="900" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
				</control>
			</control>
	
		</control>
	</controls>
</window>
