<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi contract: 1 heading, 9 text, 20 progress, 11 yes, 10 no, 12 custom button. -->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<depth>DepthDialog</depth>
	<controls>
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="B0000000">white.png</texture>
		</control>
		<control type="group">
			<left>460</left>
			<top>320</top>
			<animation effect="fade" start="0" end="100" time="160">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<control type="image">
				<width>1000</width>
				<height>420</height>
				<texture colordiffuse="F2141418">white.png</texture>
			</control>
			<control type="label" id="1">
				<left>50</left>
				<top>34</top>
				<width>900</width>
				<height>50</height>
				<font>kscape_panel_title</font>
				<textcolor>FFFFFFFF</textcolor>
			</control>
			<control type="textbox" id="9">
				<left>50</left>
				<top>104</top>
				<width>900</width>
				<height>180</height>
				<font>kscape13</font>
				<textcolor>FFC8C8D0</textcolor>
			</control>
			<control type="progress" id="20">
				<left>50</left>
				<top>292</top>
				<width>900</width>
				<height>6</height>
				<texturebg colordiffuse="40FFFFFF">white.png</texturebg>
				<midtexture colordiffuse="FFF5A01A">white.png</midtexture>
			</control>
			<control type="grouplist" id="9000">
				<left>50</left>
				<top>318</top>
				<width>900</width>
				<height>70</height>
				<orientation>horizontal</orientation>
				<align>center</align>
				<itemgap>20</itemgap>
				<control type="button" id="11">
					<width>260</width>
					<height>64</height>
					<font>kscape13</font>
					<align>center</align>
					<textcolor>FFE6E6EA</textcolor>
					<focusedcolor>FF141418</focusedcolor>
					<texturefocus colordiffuse="FFF5A01A">white.png</texturefocus>
					<texturenofocus colordiffuse="FF26262C">white.png</texturenofocus>
				</control>
				<control type="button" id="10">
					<width>260</width>
					<height>64</height>
					<font>kscape13</font>
					<align>center</align>
					<textcolor>FFE6E6EA</textcolor>
					<focusedcolor>FF141418</focusedcolor>
					<texturefocus colordiffuse="FFF5A01A">white.png</texturefocus>
					<texturenofocus colordiffuse="FF26262C">white.png</texturenofocus>
				</control>
				<control type="button" id="12">
					<width>260</width>
					<height>64</height>
					<font>kscape13</font>
					<align>center</align>
					<textcolor>FFE6E6EA</textcolor>
					<focusedcolor>FF141418</focusedcolor>
					<texturefocus colordiffuse="FFF5A01A">white.png</texturefocus>
					<texturenofocus colordiffuse="FF26262C">white.png</texturenofocus>
				</control>
			</control>
		</control>
	</controls>
</window>
